{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Typechecks all Node-side code. tsconfig.build.json emits src/ to dist/;
    // src/page/tsconfig.json covers the browser bundle.
    "noEmit": true,

    // Environment Settings
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    // For nodejs:
    "lib": ["esnext"],
    "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // Examples import the package by name, as manifest authors do; tsx honors this too.
    "paths": {
      "a-jit": ["./src/index.ts"]
    }
  },
  "include": ["src", "examples", "scripts"],
  "exclude": ["node_modules", "dist", "src/page"]
}
