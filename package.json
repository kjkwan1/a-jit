{
  "name": "a-jit",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "a-jit": "./dist/main.js"
  },
  "scripts": {
    "build": "esbuild src/page/frame.tsx src/page/host.ts src/page/*.html --bundle --format=iife --outdir=dist/page --loader:.html=copy --jsx=automatic --jsx-import-source=preact && tsc -p tsconfig.build.json",
    "typecheck": "tsc && tsc -p src/page",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "start": "tsx src/main.ts chat examples/weather.ts",
    "mcp": "tsx src/main.ts mcp examples/weather.ts",
    "demo": "npm run build && tsx scripts/demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "inquirer": "^14.2.3",
    "openai": "^7.32.0",
    "preact": "^11.0.1",
    "zod": "^4.6.5"
  },
  "files": [
    "dist"
  ]
}
